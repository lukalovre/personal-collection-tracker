<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CollectionTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:CollectionTracker.Views;assembly=CollectionTracker" mc:Ignorable="d" x:DataType="vm:GamesViewModel" x:Class="CollectionTracker.Views.GamesView" xmlns:view="using:CollectionTracker.Views">
    <DockPanel>
        <TabControl>
            <TabItem Header="★">
                <DockPanel>
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Done}" Header="Done" Width="40" />
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Year}" Header="Year" Width="70" />
                            <DataGridTextColumn Binding="{Binding Platform}" Header="Platform" Width="70" />
                            <DataGridTextColumn Binding="{Binding HLTB}" Header="HLTB" Width="80" />
                            <DataGridTextColumn Binding="{Binding Purchased, StringFormat='{}{0:yyyy-MM-dd}'}" Header="Purchased" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="All">
                <DockPanel>
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Year}" Header="Year" Width="70" />
                            <DataGridTextColumn Binding="{Binding Platform}" Header="Platform" Width="70" />
                            <DataGridTextColumn Binding="{Binding HLTB}" Header="HLTB" Width="80" />
                            <DataGridTextColumn Binding="{Binding Purchased, StringFormat='{}{0:yyyy-MM-dd}'}" Header="Purchased" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TabControl Margin="5">
            <TabItem Header="Info">
                <ScrollViewer>
                    <StackPanel>
                        <Button Content ="{Binding GridCountItemsBookmarked}"></Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Command ="{Binding IgnoreItemClick}" Margin="15">Ignore</Button>
                            <Button Command="{Binding OpenLink}">Open Link</Button>
                        </StackPanel>
                        <TextBox PlaceholderText="Title" Text="{Binding SelectedItem.Title}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Developer" Text="{Binding SelectedItem.Developer}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Year" Text="{Binding SelectedItem.Year}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Edition" Text="{Binding SelectedItem.Edition}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Platform" Text="{Binding SelectedItem.Platform}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Client" Text="{Binding SelectedItem.Client}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Price" Text="{Binding SelectedItem.Price}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding SelectedItem.PriceInRSD}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="HLTB" Text="{Binding SelectedItem.HLTB}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Owner" Text="{Binding SelectedItem.Owner}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding SelectedItem.ExternalID}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Date" Text="{Binding SelectedItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <TextBox PlaceholderText="Comment" Text="{Binding SelectedItem.Comment}" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding SelectedItem.Expansion}" IsEnabled="False">Expansion </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedItem.New}" IsEnabled="False">New </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedItem.GotFree}" IsEnabled="False">GotFree </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedItem.PhysicalCopy}" IsEnabled="False">PhysicalCopy </CheckBox>
                        </StackPanel>
                        <Image Source="{Binding Image}" Width="300"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="New">
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddItemClick}" Margin="15">Add</Button>
                            <TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" />
                        </StackPanel>
                        <TextBox PlaceholderText="Title" Text="{Binding NewItem.Title}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="Developer" Text="{Binding NewItem.Developer}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="Year" Text="{Binding NewItem.Year}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="Edition" Text="{Binding NewItem.Edition}" HorizontalAlignment="Stretch" />
                        <ComboBox ItemsSource="{Binding PlatformTypes}" SelectedItem="{Binding NewItem.Platform}" />
                        <ComboBox ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding NewItem.Client}" />
                        <TextBox PlaceholderText="Price" Text="{Binding NewItem.Price}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding NewItem.PriceInRSD}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="HLTB" Text="{Binding NewItem.HLTB}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="Owner" Text="{Binding NewItem.Owner}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding NewItem.ExternalID}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding NewItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" HorizontalAlignment="Stretch" />
                        <TextBox PlaceholderText="Comment" Text="{Binding NewItem.Comment}" HorizontalAlignment="Stretch" AcceptsReturn="True" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding NewItem.Expansion}">Expansion </CheckBox>
                            <CheckBox IsChecked="{Binding NewItem.New}">New </CheckBox>
                            <CheckBox IsChecked="{Binding NewItem.GotFree}">GotFree </CheckBox>
                            <CheckBox IsChecked="{Binding NewItem.PhysicalCopy}">PhysicalCopy </CheckBox>
                        </StackPanel>
                        <Image Source="{Binding NewImage}" Width="250"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Edit">
                <ScrollViewer>
                    <StackPanel>
                        <Button Command="{Binding UpdateItemClick}" Margin="15">Update</Button>
                        <TextBox PlaceholderText="Title" Text="{Binding SelectedItem.Title}" />
                        <TextBox PlaceholderText="Developer" Text="{Binding SelectedItem.Developer}" />
                        <TextBox PlaceholderText="Year" Text="{Binding SelectedItem.Year}" />
                        <TextBox PlaceholderText="Edition" Text="{Binding SelectedItem.Edition}" />
                        <ComboBox ItemsSource="{Binding PlatformTypes}" SelectedItem="{Binding SelectedItem.Platform}" />
                        <ComboBox ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding SelectedItem.Client}" />
                        <TextBox PlaceholderText="Price" Text="{Binding SelectedItem.Price}" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding SelectedItem.PriceInRSD}" />
                        <TextBox PlaceholderText="HLTB" Text="{Binding SelectedItem.HLTB}" />
                        <TextBox PlaceholderText="Owner" Text="{Binding SelectedItem.Owner}" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding SelectedItem.ExternalID}" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding SelectedItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding SelectedItem.Comment}" AcceptsReturn="True" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding SelectedItem.Expansion}">Expansion</CheckBox>
                            <CheckBox IsChecked="{Binding SelectedItem.New}">New</CheckBox>
                            <CheckBox IsChecked="{Binding SelectedItem.GotFree}">GotFree</CheckBox>
                            <CheckBox IsChecked="{Binding SelectedItem.PhysicalCopy}">PhysicalCopy</CheckBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>