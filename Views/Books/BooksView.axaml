<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CollectionTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:CollectionTracker.Views;assembly=CollectionTracker" mc:Ignorable="d" x:DataType="vm:BooksViewModel" x:Class="CollectionTracker.Views.BooksView" xmlns:view="using:CollectionTracker.Views">
    <DockPanel>
        <TabControl>
            <TabItem Header="★">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding GridItemsBookmarked.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Done}" Header="Done" Width="40" />
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
                            <DataGridTextColumn Binding="{Binding Type}" Header="Type" Width="60" />
                            <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="60" />
                            <DataGridTextColumn Binding="{Binding Rating}" Header="Rating" Width="40" />
                            <DataGridCheckBoxColumn Binding="{Binding _1001}" Header="1001" Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="All">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding GridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
                            <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="70" />
                            <DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd}}" Header="Last Date" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Beletristika">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding BeletristikaGridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding BeletristikaGridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
                            <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="70" />
                            <DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd}" Header="Last Date" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Dečija">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding DecijaGridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding DecijaGridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
                            <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="70" />
                            <DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd}" Header="Last Date" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Ostalo">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding OstaloGridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding OstaloGridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
                            <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="70" />
                            <DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd}" Header="Last Date" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Stručna">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding StrucnaGridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding StrucnaGridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="150" />
                            <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="70" />
                            <DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd}" Header="Last Date" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TabControl Margin="5">
            <TabItem Header="Info">
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding IgnoreItemClick}">Ignore</Button>
                            <Button Command="{Binding OpenLink}">Open Link</Button>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,6*,*">
                            <Image Grid.Column="1" Source="{Binding Image}" Height="600" Stretch="Uniform" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedItem.Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedItem.Author}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedItem.Year, StringFormat='Year: {0}'}" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Pages: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Pages}" />
                            </StackPanel>
                        </WrapPanel>
                        <view:CollectionPropertiesControl DataContext="{Binding SelectedItem}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="New">
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddItemClick}" Margin="15">Add</Button>
                            <TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" />
                        </StackPanel>
                        <TextBox PlaceholderText = "Title" Text="{Binding NewItem.Title}" />
                        <TextBox PlaceholderText = "Author" Text="{Binding NewItem.Author}" />
                        <TextBox PlaceholderText = "Year" Text="{Binding NewItem.Year}" />
                        <TextBox PlaceholderText = "Pages" Text="{Binding NewItem.Pages}" />
                        <ComboBox PlaceholderText="Type" ItemsSource="{Binding BookTypeOptions}" SelectedItem="{Binding NewItem.Type}" />
                        <TextBox PlaceholderText = "_1001" Text="{Binding NewItem._1001}" />
                        <TextBox PlaceholderText = "EminaRating" Text="{Binding NewItem.EminaRating}" />
                        <TextBox PlaceholderText = "ExternalID" Text="{Binding NewItem.ExternalID}" />
                        <TextBox PlaceholderText = "Price" Text="{Binding NewItem.Price}" />
                        <TextBox PlaceholderText = "PriceInRSD" Text="{Binding NewItem.PriceInRSD}" />
                        <TextBox PlaceholderText = "Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding NewItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding NewItem.Comment}" AcceptsReturn="True" />
                        <Button>
                            <Image Name="NewItemImage" Source="{Binding NewImage}" Width="430" Height="430" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Edit">
                <ScrollViewer>
                    <StackPanel>
                        <Button Command="{Binding UpdateItemClick}" Margin="15">Update</Button>
                        <TextBox PlaceholderText="Title" Text="{Binding SelectedItem.Title}" />
                        <TextBox PlaceholderText="Author" Text="{Binding SelectedItem.Author}" />
                        <TextBox PlaceholderText="Year" Text="{Binding SelectedItem.Year}" />
                        <TextBox PlaceholderText="Pages" Text="{Binding SelectedItem.Pages}" />
                        <TextBox PlaceholderText="Type" Text="{Binding SelectedItem.Type}" />
                        <TextBox PlaceholderText="_1001" Text="{Binding SelectedItem._1001}" />
                        <TextBox PlaceholderText="EminaRating" Text="{Binding SelectedItem.EminaRating}" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding SelectedItem.ExternalID}" />
                        <TextBox PlaceholderText="Price" Text="{Binding SelectedItem.Price}" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding SelectedItem.PriceInRSD}" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding SelectedItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding SelectedItem.Comment}" AcceptsReturn="True" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>