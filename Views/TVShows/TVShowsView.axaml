<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CollectionTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:CollectionTracker.Views;assembly=CollectionTracker" mc:Ignorable="d" x:DataType="vm:TVShowsViewModel" x:Class="CollectionTracker.Views.TVShowsView" xmlns:view="using:CollectionTracker.Views">
    <DockPanel>
        <TabControl>
            <TabItem Header="★">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding GridItemsBookmarked.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Done}" Header="Done" Width="40" />
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Season}" Header="Season" Width="70" />
                            <DataGridTextColumn Binding="{Binding Episode}" Header="Episode" Width="70" />
                            <DataGridTextColumn Binding="{Binding DaysAgo}" Header="DaysAgo" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="All">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding GridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" Width="570" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding Season}" Header="Season" Width="70" />
                            <DataGridTextColumn Binding="{Binding Episode}" Header="Episode" Width="70" />
                            <DataGridTextColumn Binding="{Binding LastDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd}}" Header="Last Date" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TabControl Margin="5">
            <TabItem Header="Info">
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command ="{Binding IgnoreItemClick}" Margin="15">Ignore</Button>
                            <Button Command="{Binding OpenLink}" ToolTip.Tip="{Binding SelectedItem.ExternalID}">Open ↗</Button>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,6*,*">
                            <Image Grid.Column="1" Source="{Binding Image}" Height="600" Stretch="Uniform" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedItem.Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Owner: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Owner}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Director: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Director}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Year: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Year}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Format: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Format}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Region: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Region}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Runtime: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Runtime}" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddEventClick}">Add pages</Button>
                            <TextBox Text="{Binding AddAmount}" PlaceholderText="Pages" />
                            <TextBlock Text="{Binding AddAmountString}" />
                        </StackPanel>
                        <view:CollectionPropertiesControl DataContext="{Binding SelectedItem}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="New">
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddItemClick}" Margin="15">Add</Button>
                            <TextBox PlaceholderText="Paste url" Text="{Binding InputUrl}" Margin="15" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Owner" />
                            <TextBox Text="{Binding NewItem.Owner}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Director" />
                            <TextBox Text="{Binding NewItem.Director}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Title" />
                            <TextBox Text="{Binding NewItem.Title}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Year" />
                            <TextBox Text="{Binding NewItem.Year}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Runtime" />
                            <TextBox Text="{Binding NewItem.Runtime}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <TextBox PlaceholderText="Format" Text="{Binding NewItem.Format}" />
                        <TextBox PlaceholderText="Region" Text="{Binding NewItem.Region}" />
                        <TextBox PlaceholderText="Price" Text="{Binding NewItem.Price}" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding NewItem.PriceInRSD}" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding NewItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding NewItem.ExternalID}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding NewItem.Comment}" AcceptsReturn="True" />
                        <Image Source="{Binding NewImage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Edit">
                <ScrollViewer>
                    <StackPanel>
                        <Button Command="{Binding UpdateItemClick}" Margin="15">Update</Button>
                        <TextBox PlaceholderText="Owner" Text="{Binding SelectedItem.Owner}" />
                        <TextBox PlaceholderText="Director" Text="{Binding SelectedItem.Director}" />
                        <TextBox PlaceholderText="Title" Text="{Binding SelectedItem.Title}" />
                        <TextBox PlaceholderText="Year" Text="{Binding SelectedItem.Year}" />
                        <TextBox PlaceholderText="Format" Text="{Binding SelectedItem.Format}" />
                        <TextBox PlaceholderText="Region" Text="{Binding SelectedItem.Region}" />
                        <TextBox PlaceholderText="Price" Text="{Binding SelectedItem.Price}" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding SelectedItem.PriceInRSD}" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding SelectedItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding SelectedItem.ExternalID}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding SelectedItem.Comment}" AcceptsReturn="True" />
                        <TextBox PlaceholderText="Runtime" Text="{Binding SelectedItem.Runtime}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>