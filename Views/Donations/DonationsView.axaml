<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CollectionTracker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:CollectionTracker.Views;assembly=CollectionTracker" mc:Ignorable="d" x:DataType="vm:DonationsViewModel" x:Class="CollectionTracker.Views.DonationsView" xmlns:view="using:CollectionTracker.Views">
    <Grid ColumnDefinitions="2*,*">
        <TabControl Grid.Column="0">
            <TabItem Header="★">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding GridItemsBookmarked.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" ItemsSource="{Binding GridItemsBookmarked}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Link}" Header="Link" Width="*" />
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding PriceInRSD}" Header="PriceInRSD" Width="100" />
                            <DataGridTextColumn Binding="{Binding Currency}" Header="Currency" Width="90" />
                            <DataGridTextColumn Binding="{Binding Price}" Header="Price" Width="90" />
                            <DataGridTextColumn Binding="{Binding Comment}" Header="Comment" Width="*" />
                            <DataGridTextColumn Binding="{Binding ExternalID}" Header="ExternalID" Width="120" />
                            <DataGridCheckBoxColumn Binding="{Binding Bookmarked}" Header="Bookmarked" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="All">
                <DockPanel>
                    <view:ItemGridSearchBox Text="{Binding SearchText}" Count="{Binding GridItems.Count}" DockPanel.Dock="Top" />
                    <DataGrid Margin="1" ItemsSource="{Binding GridItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="2" BorderBrush="Tan" SelectedItem="{Binding SelectedGridItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Link}" Header="Link" Width="*" />
                            <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                            <DataGridTextColumn Binding="{Binding PriceInRSD}" Header="PriceInRSD" Width="100" />
                            <DataGridTextColumn Binding="{Binding Currency}" Header="Currency" Width="90" />
                            <DataGridTextColumn Binding="{Binding Price}" Header="Price" Width="90" />
                            <DataGridTextColumn Binding="{Binding Comment}" Header="Comment" Width="*" />
                            <DataGridTextColumn Binding="{Binding ExternalID}" Header="ExternalID" Width="120" />
                            <DataGridCheckBoxColumn Binding="{Binding Bookmarked}" Header="Bookmarked" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TabControl Grid.Column="1" Margin="5">
            <TabItem Header="Info">
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding IgnoreItemClick}" Margin="15">Ignore</Button>
                            <Button Command="{Binding DuplicateClick}" Margin="15">Duplicate</Button>
                            <Button Command="{Binding OpenLink}" ToolTip.Tip="{Binding SelectedItem.ExternalID}">Open ↗</Button>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,6*,*">
                            <Image Grid.Column="1" Source="{Binding Image}" Height="600" Stretch="Uniform" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedItem.Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="ID: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.ID}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Link: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Link}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="Currency: " FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedItem.Currency}" />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding SelectedItem.Bookmarked}" IsEnabled="False">Bookmarked</CheckBox>
                        <view:CollectionPropertiesControl DataContext="{Binding SelectedItem}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="New">
                <ScrollViewer>
                    <StackPanel>
                        <Button Command="{Binding AddItemClick}" Margin="15">Add</Button>
                        <TextBox PlaceholderText="Link" Text="{Binding NewItem.Link}" />
                        <TextBox PlaceholderText="Title" Text="{Binding NewItem.Title}" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding NewItem.PriceInRSD}" />
                        <TextBox PlaceholderText="Currency" Text="{Binding NewItem.Currency}" />
                        <TextBox PlaceholderText="Price" Text="{Binding NewItem.Price}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding NewItem.Comment}" AcceptsReturn="True" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding NewItem.ExternalID}" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding NewItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <Button>
                            <Image Name="NewItemImage" Source="{Binding NewImage}" Width="250" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Edit">
                <ScrollViewer>
                    <StackPanel>
                        <Button Command="{Binding UpdateItemClick}" Margin="15">Update</Button>
                        <TextBox PlaceholderText="Link" Text="{Binding SelectedItem.Link}" />
                        <TextBox PlaceholderText="Title" Text="{Binding SelectedItem.Title}" />
                        <TextBox PlaceholderText="PriceInRSD" Text="{Binding SelectedItem.PriceInRSD}" />
                        <TextBox PlaceholderText="Currency" Text="{Binding SelectedItem.Currency}" />
                        <TextBox PlaceholderText="Price" Text="{Binding SelectedItem.Price}" />
                        <TextBox PlaceholderText="Comment" Text="{Binding SelectedItem.Comment}" AcceptsReturn="True" />
                        <TextBox PlaceholderText="ExternalID" Text="{Binding SelectedItem.ExternalID}" />
                        <TextBox PlaceholderText="Date (yyyy-MM-dd HH:mm:ss)" Text="{Binding SelectedItem.Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
                        <CheckBox IsChecked="{Binding SelectedItem.Bookmarked}">Bookmarked</CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>