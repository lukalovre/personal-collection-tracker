<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CollectionTracker.Views.CollectionPropertiesControl" x:CompileBindings="False">
    <Border Background="Tan" Padding="8">
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date: " FontWeight="Bold" />
                <TextBlock Text="{Binding Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Price: " FontWeight="Bold" />
                <TextBlock Text="{Binding Price}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Price (RSD): " FontWeight="Bold" />
                <TextBlock Text="{Binding PriceInRSD}" />
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Comment: " FontWeight="Bold" />
                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>