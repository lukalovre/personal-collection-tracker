<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CollectionTracker.Views.ItemGridSearchBox" x:Name="Root" x:CompileBindings="False">
    <Grid ColumnDefinitions="Auto,*" Margin="5">
        <TextBlock Text="{Binding Count, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Column="1" PlaceholderText="Search grid" Text="{Binding Text, ElementName=Root, Mode=TwoWay}" HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>